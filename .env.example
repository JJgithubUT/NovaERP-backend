# =============================================================================
# NovaERP — variables de entorno
# =============================================================================
# Copie este archivo a `.env` y complete los valores. El `.env` NO se versiona.
#
# Regla general: los valores por defecto de settings.py son los de PRODUCCION.
# Lo que no declare aquí, se comporta como en un despliegue (DEBUG apagado, sin
# claves inventadas). En desarrollo hay que declarar DEBUG=True explícitamente.
# =============================================================================

# --------------------------------------------------------------- Django
# True SOLO en desarrollo. Con DEBUG=True se sirven tracebacks y SQL al cliente.
DEBUG=True

# Firma los JWT de toda la API (tenants y plataforma), no solo las cookies.
# Cambiarla INVALIDA todas las sesiones vivas: es el botón de pánico ante una
# filtración. Nunca la comparta entre entornos.
# Genere una con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# En despliegue es obligatoria y debe tener al menos 50 caracteres.
SECRET_KEY=

# Dominios que sirven la API, separados por coma. Obligatorio con DEBUG=False.
ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes del frontend, separados por coma y SIN barra final.
# Vite usa 5173 y Angular 4200; liste los que aplique.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:5173

# RF-20: solo True si hay un reverse proxy de confianza reescribiendo
# X-Forwarded-For. Sin proxy delante, cualquier cliente podría falsear la IP
# que queda en la bitácora. También habilita la detección de HTTPS tras proxy.
USE_X_FORWARDED_FOR=False

# --------------------------------------------------------------- PostgreSQL
# Alternativa a las 5 variables sueltas: si el proveedor solo da una cadena de
# conexión (Render, Heroku, Railway...), defina DATABASE_URL y omita DB_NAME/
# DB_USER/DB_PASSWORD/DB_HOST/DB_PORT. Cualquier DB_* que sí declare gana sobre
# lo que traiga la URL (útil para pisar un solo campo, p.ej. DB_SSLMODE).
# DATABASE_URL=postgresql://usuario:password@host:5432/nombre_db
DB_NAME=novaerp
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Conexiones persistentes, en segundos (0 = abrir y cerrar en cada petición).
DB_CONN_MAX_AGE=60
# prefer | require | verify-ca | verify-full. Con la base en otra máquina,
# 'require' como mínimo.
DB_SSLMODE=prefer
# Corta una consulta colgada antes de que retenga un worker web.
DB_STATEMENT_TIMEOUT_MS=30000

# --------------------------------------------------------------- Correo (RF-25)
# Ver la guía completa en docs/DESPLIEGUE-CORREO.md
#
# Desarrollo (imprime el correo en el terminal, no envía nada):
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
#
# Despliegue (SMTP real): descomente y complete.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.ejemplo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True        # puerto 587 (STARTTLS)
# EMAIL_USE_SSL=False       # puerto 465 (TLS implícito). Excluyente con el anterior.

# Remitente de las notificaciones. Debe ser un buzón autorizado por el
# proveedor SMTP, o los correos se marcarán como spam o serán rechazados.
DEFAULT_FROM_EMAIL=no-reply@novaerp.local
# Remitente de los errores del propio servidor (por defecto, el anterior).
SERVER_EMAIL=
# Segundos antes de abandonar un envío que no responde.
EMAIL_TIMEOUT=20

# Origen del frontend (sin barra final): con esto los correos con token
# (activación, verificación de correo, restablecimiento) llevan un enlace
# clicable además del token en claro. Obligatorio fuera de DEBUG.
FRONTEND_URL=http://localhost:5173

# --------------------------------------------------------------- Sesiones
# Expiración del JWT del portal de plataforma (SysAdmin). La de los tenants es
# por tenant y se configura desde la app (RF-22), no aquí.
SYSADMIN_JWT_EXPIRACION_HORAS=8

# --------------------------------------------------------------- HTTPS
# Todo lo de esta sección solo aplica con DEBUG=False.
#
# Redirige http:// a https://. Déjelo en True salvo que el proxy ya lo haga.
SECURE_SSL_REDIRECT=True
# HSTS: empiece en 0 y suba (3600 → 86400 → 31536000) solo con el certificado
# estable. Un valor alto con HTTPS roto deja el dominio inaccesible ese tiempo.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
# Orígenes de confianza para CSRF (con esquema). Por defecto, los de CORS.
CSRF_TRUSTED_ORIGINS=

# --------------------------------------------------------------- Regional
LANGUAGE_CODE=es-mx
# Las marcas de tiempo se guardan en UTC; esto solo afecta cómo se interpretan.
TIME_ZONE=UTC

# --------------------------------------------------------------- Diagnóstico
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Ponga DEBUG para ver cada consulta SQL. Ensordecedor: solo para depurar.
LOG_LEVEL_SQL=WARNING

# Destino de `manage.py collectstatic`.
STATIC_ROOT=
