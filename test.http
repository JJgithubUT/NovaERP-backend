###########################################################
# PRUEBAS DE SEGURIDAD
###########################################################

# Aprobado 🟩
GET {{host}}/api/core/me/

###

# Aprobado 🟩
GET {{host}}/api/inventario/productos/
Authorization: Bearer token_invalido

###

# Aprobado 🟩
POST {{host}}/api/auth/login/
Content-Type: application/json

{
    "tenant_slug":"acme",
    "correo":"admin@acme.com",
    "password":"incorrecta"
}

###

###########################################################
# PORTAL DE PLATAFORMA — SESION DEL SYSADMIN
# Fundacion de auth del Administrador Global (fuera de todo tenant).
# Habilita RF-01..04. Superficie separada de la de tenant:
#   · token con typ="sysadmin", sesion en core.sesion_sysadmin
#   · login de UNA fase, sin MFA por ahora (decision aprobada)
#
# REQUISITO PREVIO: sembrar el primer SysAdmin (no hay ninguno por defecto):
#   SYSADMIN_EMAIL="root@novaerp.local" SYSADMIN_PASSWORD="PlataformaSegura2026!" \
#     python manage.py crear_sysadmin
# Ajusta las variables de abajo si usaste otras credenciales.
###########################################################

@adminEmail = root@novaerp.local
@adminPassword = PlataformaSegura2026!

# 1) LOGIN correcto (una fase) -> 200 + token de plataforma. Guarda adminToken.
POST {{host}}/api/admin/login/
Content-Type: application/json

{
  "correo": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

> {%
const body = response.parsedBody;
client.global.set("adminToken", body.token);
%}

###

# 2) LOGIN password incorrecta -> 401 (se audita LOGIN_FAILED, no se cuenta:
#    sin bloqueo por ahora)
POST {{host}}/api/admin/login/
Content-Type: application/json

{
  "correo": "{{adminEmail}}",
  "password": "incorrecta"
}

###

# 3) LOGIN correo inexistente -> 401 (no revela existencia; se audita el correo
#    intentado)
POST {{host}}/api/admin/login/
Content-Type: application/json

{
  "correo": "noexiste@novaerp.local",
  "password": "loquesea1234"
}

###

# 4) Endpoint protegido de plataforma CON token de sysadmin -> 200 (logout)
#    Cierra la sesion en curso; el mismo token queda revocado de inmediato.
POST {{host}}/api/admin/logout/
Authorization: Bearer {{adminToken}}

###

# 5) Reusar el token DESPUES del logout -> 401 (sesion revocada; idempotente)
POST {{host}}/api/admin/logout/
Authorization: Bearer {{adminToken}}

###

# 6) Endpoint protegido de plataforma SIN token -> 401
POST {{host}}/api/admin/logout/

###

# 7) AISLAMIENTO: token de sysadmin en un endpoint de tenant (/me) -> 401
#    (un SysAdmin no es un usuario de tenant). Vuelve a hacer login (paso 1)
#    para tener un adminToken vivo antes de probar esto.
GET {{host}}/api/core/me/
Authorization: Bearer {{adminToken}}

###

# 8) AISLAMIENTO inverso: token de TENANT en el endpoint de plataforma -> 401
#    (usa {{token}} del login de tenant de dos fases de mas arriba)
POST {{host}}/api/admin/logout/
Authorization: Bearer {{token}}

###

###########################################################
# MODULO 1 — ADMINISTRACION DE MULTI-TENENCIA (RF-01..RF-04)
# Todo el bloque exige una sesion de SysAdmin: haz primero el login del portal
# (seccion anterior, paso 1) para tener {{adminToken}} vivo.
###########################################################

@nuevoSlug = probadora
@nuevoAdminCorreo = jefa@probadora.com

# RF-01: registrar un tenant. Nace 'pendiente'; devuelve el token de activacion
# (en dev; el worker de correo lo entrega al admin inicial). Guarda id y token.
POST {{host}}/api/admin/tenants/
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "slug": "{{nuevoSlug}}",
  "razon_social": "Probadora SA de CV",
  "dominio_comercial": "Servicios",
  "correo": "{{nuevoAdminCorreo}}",
  "nombre_completo": "Jefa Probadora",
  "plan": "STARTER"
}

> {%
const b = response.parsedBody;
client.global.set("tenantId", b.id);
client.global.set("activacionTenantToken", b.activacion_token);
%}

###

# RF-01/CA10: dominio reservado -> 422 "Este dominio esta reservado..."
POST {{host}}/api/admin/tenants/
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "slug": "admin",
  "razon_social": "Reservada SA",
  "correo": "x@reservada.com",
  "nombre_completo": "X",
  "plan": "BUSINESS"
}

###

# RF-01/RN04: correo ya usado en la plataforma (admin@acme.com) -> 422
POST {{host}}/api/admin/tenants/
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "slug": "otra-org",
  "razon_social": "Otra Org SA",
  "correo": "admin@acme.com",
  "nombre_completo": "X",
  "plan": "BUSINESS"
}

###

# RF-01 flujo de activacion (PUBLICO, sin token de sesion): el admin inicial fija
# su contrasena; en cascada el usuario Y el tenant pasan a 'activo'.
POST {{host}}/api/auth/activar-tenant/
Content-Type: application/json

{
  "token": "{{activacionTenantToken}}",
  "password": "ClaveSegura2026"
}

###

# RF-02: listar tenants (paginado, filtros ?estado= ?plan= ?search= ?orden= ?desc=)
GET {{host}}/api/admin/tenants/?search=probadora&orden=created_at&desc=true
Authorization: Bearer {{adminToken}}

###

# RF-02/CA05: detalle de un tenant (modulos activos, licencias)
GET {{host}}/api/admin/tenants/{{tenantId}}/
Authorization: Bearer {{adminToken}}

###

# RF-03: editar datos generales (renombrar). No afecta datos existentes.
PATCH {{host}}/api/admin/tenants/{{tenantId}}/
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "razon_social": "Probadora Renombrada SA"
}

###

# RF-03/CA08: activar un modulo cuya dependencia no esta activa -> 422
# (STARTER trae INVENTARIO; VENTAS no esta en STARTER -> primero falla por plan)
PATCH {{host}}/api/admin/tenants/{{tenantId}}/
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "modulos": { "activar": ["VENTAS"] }
}

###

# RF-03: subir a BUSINESS (incluye ventas/compras) y activar VENTAS (su
# dependencia INVENTARIO ya esta activa). Dos cambios en un PATCH.
PATCH {{host}}/api/admin/tenants/{{tenantId}}/
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "plan": "BUSINESS",
  "modulos": { "activar": ["VENTAS"] }
}

###

# RF-03/RN07/CA09: desactivar INVENTARIO (del que depende VENTAS) SIN cascada
# -> 422 con requiere_confirmar_cascada=true y la lista de modulos_afectados.
PATCH {{host}}/api/admin/tenants/{{tenantId}}/
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "modulos": { "desactivar": ["INVENTARIO"] }
}

###

# RF-03: la misma desactivacion CON confirmacion de cascada -> 200
# (apaga INVENTARIO y sus dependientes en un solo proceso atomico).
PATCH {{host}}/api/admin/tenants/{{tenantId}}/
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "modulos": { "desactivar": ["INVENTARIO"] },
  "confirmar_cascada": true
}

###

# RF-04: suspender el tenant (tipo cumplimiento/administrativa + motivo).
# Invalida todas las sesiones de sus usuarios y bloquea su login.
POST {{host}}/api/admin/tenants/{{tenantId}}/suspender/
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "tipo": "administrativa",
  "motivo": "Impago del periodo"
}

###

# RF-04/RN05: reactivar el tenant suspendido (sin perdida de informacion)
POST {{host}}/api/admin/tenants/{{tenantId}}/reactivar/
Authorization: Bearer {{adminToken}}

###

# RF-04: dar de baja logica (?baja=true). Reversible con reactivar.
POST {{host}}/api/admin/tenants/{{tenantId}}/suspender/?baja=true
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "tipo": "administrativa",
  "motivo": "Cierre de cuenta"
}

###

###########################################################
# MODULO 8 — VENTAS / CRM TRANSACCIONAL (RF-30..RF-44)
# Requiere un usuario de tenant autenticado (login de dos fases de arriba,
# {{token}}) con permisos de ventas. El TENANT_ADMIN (admin@acme.com) los tiene
# todos por bypass. Usa un producto y almacen existentes del tenant acme.
###########################################################

@ventasToken = {{token}}
@clienteVentas = REEMPLAZA_CON_UN_CLIENTE_ID
@productoVentas = REEMPLAZA_CON_UN_PRODUCTO_ID
@almacenVentas = REEMPLAZA_CON_UN_ALMACEN_ID

# --- RF-30..33 Oportunidades ---

# RF-30: registrar oportunidad (nace en 'prospeccion'/'abierta')
POST {{host}}/api/ventas/oportunidades/
Authorization: Bearer {{ventasToken}}
Content-Type: application/json

{
  "cliente_id": "{{clienteVentas}}",
  "nombre": "Venta trimestral",
  "valor_estimado": "50000",
  "fecha_cierre_estimada": "2026-12-31"
}

> {%
client.global.set("oportunidadId", response.parsedBody.id);
%}

###

# RF-31: pipeline kanban (conteo, valor total y ponderado por etapa)
GET {{host}}/api/ventas/oportunidades/pipeline/
Authorization: Bearer {{ventasToken}}

###

# RF-31: listado tabular (solo propias salvo ventas:pipeline:ver_todo)
GET {{host}}/api/ventas/oportunidades/?estado=abierta
Authorization: Bearer {{ventasToken}}

###

# RF-32: avanzar la etapa (solo a la siguiente en la secuencia)
POST {{host}}/api/ventas/oportunidades/{{oportunidadId}}/etapa/
Authorization: Bearer {{ventasToken}}
Content-Type: application/json

{ "etapa": "calificacion" }

###

# RF-33: cerrar como perdida (motivo del catalogo obligatorio) o ganada
POST {{host}}/api/ventas/oportunidades/{{oportunidadId}}/cerrar/
Authorization: Bearer {{ventasToken}}
Content-Type: application/json

{ "estado": "ganada" }

###

# --- RF-34..37 Cotizaciones ---

# RF-34: generar cotizacion (precio del catalogo; totales automaticos)
POST {{host}}/api/ventas/cotizaciones/
Authorization: Bearer {{ventasToken}}
Content-Type: application/json

{
  "cliente_id": "{{clienteVentas}}",
  "descuento_pct": "10",
  "vigente_hasta": "2026-12-31",
  "lineas": [
    { "producto_id": "{{productoVentas}}", "cantidad": "3" }
  ]
}

> {%
client.global.set("cotizacionId", response.parsedBody.id);
%}

###

# RF-35: listar cotizaciones (?estado= ?cliente_id= ?vencida=true ?desde=&hasta=)
GET {{host}}/api/ventas/cotizaciones/
Authorization: Bearer {{ventasToken}}

###

# RF-36: editar cotizacion (solo borrador / pendiente_aprobacion)
PATCH {{host}}/api/ventas/cotizaciones/{{cotizacionId}}/
Authorization: Bearer {{ventasToken}}
Content-Type: application/json

{ "descuento_pct": "5" }

###

# RF-37: aprobar / rechazar (una vencida no se aprueba)
POST {{host}}/api/ventas/cotizaciones/{{cotizacionId}}/resolver/
Authorization: Bearer {{ventasToken}}
Content-Type: application/json

{ "decision": "aprobar" }

###

# --- RF-38..41 Pedidos ---

# RF-38: crear pedido (desde cotizacion aprobada -> "cotizacion_id", o directo)
POST {{host}}/api/ventas/pedidos/
Authorization: Bearer {{ventasToken}}
Content-Type: application/json

{
  "cliente_id": "{{clienteVentas}}",
  "lineas": [
    { "producto_id": "{{productoVentas}}", "cantidad": "3" }
  ]
}

> {%
client.global.set("pedidoId", response.parsedBody.id);
%}

###

# RF-38: confirmar (reserva stock en el almacen; valida limite de credito).
# Si excede el credito, agrega "autorizar_credito": true (requiere permiso
# finanzas:credito:autorizar). Sin stock y con backorder -> pendiente_surtido.
POST {{host}}/api/ventas/pedidos/{{pedidoId}}/confirmar/
Authorization: Bearer {{ventasToken}}
Content-Type: application/json

{ "almacen_id": "{{almacenVentas}}" }

###

# RF-39: listar pedidos
GET {{host}}/api/ventas/pedidos/?estado=confirmado
Authorization: Bearer {{ventasToken}}

###

# RF-41: cancelar pedido (libera el stock reservado). Un pedido facturado -> 422
POST {{host}}/api/ventas/pedidos/{{pedidoId}}/cancelar/
Authorization: Bearer {{ventasToken}}

###

# --- RF-42..44 Facturas y Notas de Credito ---

# RF-42: generar factura de un pedido confirmado (parcial o total). Sin "lineas"
# factura todo lo pendiente y reservado. Descuenta stock (salida) y crea la CxC.
POST {{host}}/api/ventas/facturas/
Authorization: Bearer {{ventasToken}}
Content-Type: application/json

{ "pedido_id": "{{pedidoId}}" }

> {%
client.global.set("facturaId", response.parsedBody.id);
%}

###

# RF-43: listar / consultar facturas
GET {{host}}/api/ventas/facturas/?cliente_id={{clienteVentas}}
Authorization: Bearer {{ventasToken}}

###

# RF-44: nota de credito (revierte CxC; NC total con reingresar_stock=true
# reingresa el stock facturado). La factura queda 'con_nota_credito'.
POST {{host}}/api/ventas/facturas/{{facturaId}}/nota-credito/
Authorization: Bearer {{ventasToken}}
Content-Type: application/json

{
  "motivo": "Devolucion total",
  "monto": "3364.00",
  "reingresar_stock": true
}

###

# ============================================================================
# RV-01..06 REPORTES DE VENTAS
# Ver docs/api/FLUJO-VENTAS-REPORTES.md y docs/SPRINT-REPORTES-VENTAS.md.
#
# Los seis exigen ventas:reportes:leer. Con ?formato=csv|pdf devuelven el
# archivo completo y exigen ademas ventas:reportes:exportar (403 si falta).
# desde/hasta son obligatorios (400 si faltan) y el rango no puede pasar de
# 366 dias (422). Importes en string decimal: parsear con decimal, no float.
# ============================================================================

# RV-01: facturacion agregada por mes. venta_neta = facturado - notas de credito.
# Una NC se imputa al mes de SU fecha, no al de la factura que corrige.
GET {{host}}/api/ventas/reportes/ventas-por-periodo/?desde=2026-01-01&hasta=2026-12-31&agrupar=mes
Authorization: Bearer {{ventasToken}}

###

# RV-01: mismo reporte por dia y acotado a un cliente.
GET {{host}}/api/ventas/reportes/ventas-por-periodo/?desde=2026-07-01&hasta=2026-07-31&agrupar=dia&cliente_id={{clienteVentas}}
Authorization: Bearer {{ventasToken}}

###

# RV-02: top 10 de clientes por venta neta. Los totales agregan TODOS los
# clientes del rango, no solo el top: cambiar limit no cambia los totales.
GET {{host}}/api/ventas/reportes/clientes/?desde=2026-01-01&hasta=2026-12-31&orden=monto&limit=10
Authorization: Bearer {{ventasToken}}

###

# RV-03: top de productos. OJO: importe BRUTO, las notas de credito no tienen
# desglose por linea y no se descuentan aqui (por eso no cuadra con RV-01).
GET {{host}}/api/ventas/reportes/productos/?desde=2026-01-01&hasta=2026-12-31&orden=cantidad&limit=20
Authorization: Bearer {{ventasToken}}

###

# RV-04: embudo. Cada etapa cuenta documentos CREADOS en el rango; la
# conversion es respecto de la etapa anterior, no un seguimiento por documento.
GET {{host}}/api/ventas/reportes/embudo/?desde=2026-01-01&hasta=2026-12-31
Authorization: Bearer {{ventasToken}}

###

# RV-05: cartera a una fecha de corte (no usa rango). El saldo se reconstruye
# A ESA FECHA. La antiguedad son dias DESDE LA EMISION, no dias vencidos.
GET {{host}}/api/ventas/reportes/cartera/?corte=2026-07-31
Authorization: Bearer {{ventasToken}}

###

# RV-05 con el detalle factura a factura (paginado).
GET {{host}}/api/ventas/reportes/cartera/?corte=2026-07-31&detalle=true&page=1&page_size=20
Authorization: Bearer {{ventasToken}}

###

# RV-06: desempeno por vendedor. La fila con vendedor_id null ("Sin asignar")
# son documentos sin atribucion; nunca se reparten entre los vendedores.
GET {{host}}/api/ventas/reportes/vendedores/?desde=2026-01-01&hasta=2026-12-31
Authorization: Bearer {{ventasToken}}

###

# Exportacion: exige ventas:reportes:exportar y se audita como evento EXPORT.
GET {{host}}/api/ventas/reportes/ventas-por-periodo/?desde=2026-01-01&hasta=2026-12-31&formato=csv
Authorization: Bearer {{ventasToken}}

###

GET {{host}}/api/ventas/reportes/clientes/?desde=2026-01-01&hasta=2026-12-31&formato=pdf
Authorization: Bearer {{ventasToken}}

###

# Errores esperados --------------------------------------------------------

# 400: faltan desde/hasta
GET {{host}}/api/ventas/reportes/ventas-por-periodo/
Authorization: Bearer {{ventasToken}}

###

# 400: agrupar fuera del catalogo
GET {{host}}/api/ventas/reportes/ventas-por-periodo/?desde=2026-01-01&hasta=2026-01-31&agrupar=trimestre
Authorization: Bearer {{ventasToken}}

###

# 422: rango mayor a 366 dias
GET {{host}}/api/ventas/reportes/ventas-por-periodo/?desde=2024-01-01&hasta=2026-01-01
Authorization: Bearer {{ventasToken}}
