###########################################################
# NovaERP Backend
# REST Client (VS Code)
###########################################################

@host = http://127.0.0.1:8000
@tenant = acme
@email = admin@acme.com
@password = CambiarEnPrimerLogin!

###########################################################
# LOGIN (RF-16) — DOS FASES: password -> reto OTP -> sesion
###########################################################

# FASE 1: valida password. NO devuelve token de sesion; devuelve un reto.
#   · mfa:"enroll" (primer login / admin sembrado) -> incluye "secret" y
#     "otpauth_uri" una sola vez; configura tu autenticador con ese secreto.
#   · mfa:"otp" (ya enrolado) -> solo el reto.
POST {{host}}/api/auth/login/
Content-Type: application/json

{
  "tenant_slug": "{{tenant}}",
  "correo": "{{email}}",
  "password": "{{password}}"
}

> {%
const body = response.parsedBody;
client.global.set("reto", body.reto);
// En enrolamiento, guarda el secreto para generar el codigo en tu app TOTP:
if (body.secret) { client.global.set("mfaSecret", body.secret); }
%}

###

# FASE 2: envia el codigo de 6 digitos de tu app autenticadora (o el generado
# con el secret del enrolamiento). REST Client no calcula TOTP: pega el codigo
# actual a mano. Devuelve el token de sesion definitivo.
POST {{host}}/api/auth/otp/
Content-Type: application/json

{
  "reto": "{{reto}}",
  "codigo": "000000"
}

> {%
const body = response.parsedBody;
client.global.set("token", body.token);
%}

###

# Codigo incorrecto -> 401 y cuenta como intento fallido (mismo bloqueo global)
POST {{host}}/api/auth/otp/
Content-Type: application/json

{
  "reto": "{{reto}}",
  "codigo": "111111"
}

###

# Perfil del usuario autenticado (usa el token de la fase 2)
GET {{host}}/api/core/me/
Authorization: Bearer {{token}}

###

# RF-16/RN02 — bloqueo por intentos fallidos.
# Repetir este POST 5 veces con password incorrecta: cada uno responde 401
# ("Credenciales incorrectas", RN04) y registra LOGIN_FAILED. El 5o dispara el
# bloqueo: evento ACCOUNT_LOCKED (criticidad ALTA) + notificacion encolada.
POST {{host}}/api/auth/login/
Content-Type: application/json

{
  "tenant_slug": "{{tenant}}",
  "correo": "{{email}}",
  "password": "password-incorrecta"
}

###

# 6o intento estando bloqueado -> 401 con "Cuenta bloqueada..." (no cuenta, no
# re-bloquea). Incluso con la password correcta se rechaza mientras dure el
# bloqueo (CA04). Esperar el tiempo de bloqueo o resetear en DB para reintentar.
POST {{host}}/api/auth/login/
Content-Type: application/json

{
  "tenant_slug": "{{tenant}}",
  "correo": "{{email}}",
  "password": "{{password}}"
}

###

###########################################################
# PERFIL
###########################################################

# Aprobado 🟩
GET {{host}}/api/core/me/
Authorization: Bearer {{token}}

