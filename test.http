###########################################################
# NovaERP Backend
# REST Client (VS Code)
###########################################################

@host = http://127.0.0.1:8000
@tenant = acme
@email = admin@acme.com
@password = CambiarEnPrimerLogin!

###########################################################
# LOGIN
###########################################################

# Aprobado 🟩
POST {{host}}/api/auth/login/
Content-Type: application/json

{
  "tenant_slug": "{{tenant}}",
  "correo": "{{email}}",
  "password": "{{password}}"
}

> {%
const body = response.parsedBody;
client.global.set("token", body.token);
%}

###

###########################################################
# PERFIL
###########################################################

# Aprobado 🟩
GET {{host}}/api/core/me/
Authorization: Bearer {{token}}

###

###########################################################
# PRODUCTOS
###########################################################

# Aprobado 🟩
GET {{host}}/api/inventario/productos/
Authorization: Bearer {{token}}

###

# Aprobado 🟩
GET {{host}}/api/inventario/productos/?page=1&page_size=20
Authorization: Bearer {{token}}

###

# Aprobado 🟩
GET {{host}}/api/inventario/productos/?search=LAP
Authorization: Bearer {{token}}

###

# Aprobado 🟩
GET {{host}}/api/inventario/productos/?activo=true
Authorization: Bearer {{token}}

###

# Aprobado 🟩
POST {{host}}/api/inventario/productos/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "sku":"LAP-{{$guid}}",
    "nombre":"Laptop 15",
    "descripcion":"Equipo de prueba",
    "costo_referencia":"9000",
    "precio_venta":"13500",
    "stock_minimo":"5"
}

> {%
const body = response.parsedBody;
client.global.set("productoId", body.id);
client.global.set("productoSku", body.sku);
%}

###

# Repite el SKU recien creado a proposito -> debe responder 422 con campo:"sku"

# Aprobado 🟩
POST {{host}}/api/inventario/productos/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "sku":"{{productoSku}}",
    "nombre":"Laptop 15 duplicada",
    "costo_referencia":"1",
    "precio_venta":"1"
}

###

# Aprobado 🟩
# precio_venta negativo -> debe responder 422 con campo:"precio_venta"
POST {{host}}/api/inventario/productos/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "sku":"LAP-{{$guid}}",
    "nombre":"Producto con precio invalido",
    "costo_referencia":"1",
    "precio_venta":"-50"
}

###

# Aprobado 🟩
# productoId se llena solo con la respuesta del POST de arriba
PATCH {{host}}/api/inventario/productos/{{productoId}}/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "precio_venta":"15000"
}

###

# Aprobado 🟩
DELETE {{host}}/api/inventario/productos/{{productoId}}/
Authorization: Bearer {{token}}

###

###########################################################
# ALMACENES
###########################################################

# Aprobado 🟩
GET {{host}}/api/inventario/almacenes/
Authorization: Bearer {{token}}

###

# Aprobado 🟩
POST {{host}}/api/inventario/almacenes/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "nombre":"Almacén Central {{$guid}}",
    "ubicacion":"Planta Baja"
}

> {%
const body = response.parsedBody;
client.global.set("almacenId", body.id);
%}

###

# Aprobado 🟩
# almacenId se llena solo con la respuesta del POST de arriba
PATCH {{host}}/api/inventario/almacenes/{{almacenId}}/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "ubicacion":"Segundo Piso"
}

###

# Aprobado 🟩
DELETE {{host}}/api/inventario/almacenes/{{almacenId}}/
Authorization: Bearer {{token}}

###

###########################################################
# CLIENTES
###########################################################

# Aprobado 🟩
GET {{host}}/api/ventas/clientes/
Authorization: Bearer {{token}}

###

# Aprobado 🟩
POST {{host}}/api/ventas/clientes/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "rfc_o_id_fiscal":"RFC-{{$guid}}",
    "razon_social":"Cliente REST",
    "correo":"cliente@test.com",
    "telefono":"5555555555",
    "limite_credito":"5000"
}

> {%
const body = response.parsedBody;
client.global.set("clienteId", body.id);
%}

###

# Aprobado 🟩
# clienteId se llena solo con la respuesta del POST de arriba
PATCH {{host}}/api/ventas/clientes/{{clienteId}}/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "telefono":"2222222222"
}

###

# Aprobado 🟩
DELETE {{host}}/api/ventas/clientes/{{clienteId}}/
Authorization: Bearer {{token}}

###

###########################################################
# PROVEEDORES
###########################################################

# Aprobado 🟩
GET {{host}}/api/compras/proveedores/
Authorization: Bearer {{token}}

###

# Aprobado 🟩
POST {{host}}/api/compras/proveedores/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "rfc_o_id_fiscal":"RFC-{{$guid}}",
    "razon_social":"Proveedor REST",
    "correo":"proveedor@test.com",
    "telefono":"7777777777"
}

> {%
const body = response.parsedBody;
client.global.set("proveedorId", body.id);
%}

###

# Aprobado 🟩
# proveedorId se llena solo con la respuesta del POST de arriba
PATCH {{host}}/api/compras/proveedores/{{proveedorId}}/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "telefono":"9999999999"
}

###

# Aprobado 🟩
DELETE {{host}}/api/compras/proveedores/{{proveedorId}}/
Authorization: Bearer {{token}}

###

###########################################################
# MOVIMIENTOS DE INVENTARIO (RF-58) - Sprint 2
###########################################################

# Producto y almacen base para las pruebas de la capa transaccional
POST {{host}}/api/inventario/productos/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "sku":"MOV-{{$guid}}",
    "nombre":"Producto para movimientos",
    "costo_referencia":"100",
    "precio_venta":"150",
    "stock_minimo":"10"
}

> {%
const body = response.parsedBody;
client.global.set("movProductoId", body.id);
%}

###

POST {{host}}/api/inventario/almacenes/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "nombre":"Almacen Movimientos {{$guid}}",
    "ubicacion":"Bodega 1"
}

> {%
const body = response.parsedBody;
client.global.set("movAlmacenOrigenId", body.id);
%}

###

POST {{host}}/api/inventario/almacenes/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "nombre":"Almacen Movimientos Destino {{$guid}}",
    "ubicacion":"Bodega 2"
}

> {%
const body = response.parsedBody;
client.global.set("movAlmacenDestinoId", body.id);
%}

###

# Entrada manual: carga inicial de stock
POST {{host}}/api/inventario/movimientos/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "producto_id":"{{movProductoId}}",
    "almacen_id":"{{movAlmacenOrigenId}}",
    "tipo":"entrada",
    "cantidad":"50",
    "costo_unitario":"100"
}

###

# Salida manual
POST {{host}}/api/inventario/movimientos/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "producto_id":"{{movProductoId}}",
    "almacen_id":"{{movAlmacenOrigenId}}",
    "tipo":"salida",
    "cantidad":"5"
}

###

# Salida que excede el stock disponible -> debe responder 422 con campo:"cantidad"
POST {{host}}/api/inventario/movimientos/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "producto_id":"{{movProductoId}}",
    "almacen_id":"{{movAlmacenOrigenId}}",
    "tipo":"salida",
    "cantidad":"99999"
}

###

# tipo invalido -> debe responder 422 con campo:"tipo"
POST {{host}}/api/inventario/movimientos/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "producto_id":"{{movProductoId}}",
    "almacen_id":"{{movAlmacenOrigenId}}",
    "tipo":"ajuste_positivo",
    "cantidad":"1"
}

###

GET {{host}}/api/inventario/movimientos/
Authorization: Bearer {{token}}

###

GET {{host}}/api/inventario/movimientos/?producto_id={{movProductoId}}
Authorization: Bearer {{token}}

###

###########################################################
# STOCK DISPONIBLE (RF-59) - Sprint 2
###########################################################

GET {{host}}/api/inventario/stock-disponible/
Authorization: Bearer {{token}}

###

GET {{host}}/api/inventario/stock-disponible/?producto_id={{movProductoId}}
Authorization: Bearer {{token}}

###

###########################################################
# AJUSTES DE INVENTARIO (RF-60) - Sprint 2
###########################################################

# Ajuste positivo (conteo fisico encontro mas stock del esperado)
POST {{host}}/api/inventario/ajustes/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "producto_id":"{{movProductoId}}",
    "almacen_id":"{{movAlmacenOrigenId}}",
    "motivo":"conteo_fisico",
    "cantidad":"10"
}

###

# Ajuste negativo (merma)
POST {{host}}/api/inventario/ajustes/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "producto_id":"{{movProductoId}}",
    "almacen_id":"{{movAlmacenOrigenId}}",
    "motivo":"merma",
    "cantidad":"-3"
}

###

# motivo invalido -> debe responder 422 con campo:"motivo"
POST {{host}}/api/inventario/ajustes/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "producto_id":"{{movProductoId}}",
    "almacen_id":"{{movAlmacenOrigenId}}",
    "motivo":"robo",
    "cantidad":"-1"
}

###

# cantidad cero -> debe responder 422 con campo:"cantidad"
POST {{host}}/api/inventario/ajustes/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "producto_id":"{{movProductoId}}",
    "almacen_id":"{{movAlmacenOrigenId}}",
    "motivo":"otro",
    "cantidad":"0"
}

###

GET {{host}}/api/inventario/ajustes/
Authorization: Bearer {{token}}

###

###########################################################
# TRANSFERENCIAS ENTRE ALMACENES (RF-61) - Sprint 2
###########################################################

POST {{host}}/api/inventario/transferencias/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "producto_id":"{{movProductoId}}",
    "almacen_origen_id":"{{movAlmacenOrigenId}}",
    "almacen_destino_id":"{{movAlmacenDestinoId}}",
    "cantidad":"5"
}

###

# Mismo almacen de origen y destino -> debe responder 422 con campo:"almacen_destino_id"
POST {{host}}/api/inventario/transferencias/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "producto_id":"{{movProductoId}}",
    "almacen_origen_id":"{{movAlmacenOrigenId}}",
    "almacen_destino_id":"{{movAlmacenOrigenId}}",
    "cantidad":"1"
}

###

GET {{host}}/api/inventario/transferencias/
Authorization: Bearer {{token}}

###

###########################################################
# KARDEX (RF-62) - Sprint 2
###########################################################

GET {{host}}/api/inventario/kardex/
Authorization: Bearer {{token}}

###

GET {{host}}/api/inventario/kardex/?sku={{productoSku}}
Authorization: Bearer {{token}}

###

###########################################################
# ALERTAS DE STOCK MINIMO (RF-63) - Sprint 2
###########################################################

GET {{host}}/api/inventario/alertas-stock-minimo/
Authorization: Bearer {{token}}

###

GET {{host}}/api/inventario/alertas-stock-minimo/?notificada=false
Authorization: Bearer {{token}}

###

# Requiere que exista al menos una alerta disparada (stock <= stock_minimo);
# reemplazar {{alertaId}} manualmente con el id devuelto por el GET anterior.
# POST {{host}}/api/inventario/alertas-stock-minimo/{{alertaId}}/notificar/
# Authorization: Bearer {{token}}

###

###########################################################
# VALUACION DE INVENTARIO (RF-64) - Sprint 2
###########################################################

GET {{host}}/api/inventario/valuacion/
Authorization: Bearer {{token}}

###

GET {{host}}/api/inventario/valuacion/?almacen_id={{movAlmacenOrigenId}}
Authorization: Bearer {{token}}

###

###########################################################
# COMPRAS - ORDENES, RECEPCIONES, CxP, HISTORIAL (RF-47 a RF-52)
###########################################################

# Proveedor, producto y almacen propios para este bloque (el proveedorId
# de mas arriba ya quedo inactivo por el DELETE de la seccion PROVEEDORES).
POST {{host}}/api/compras/proveedores/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "rfc_o_id_fiscal":"RFC-OC-{{$guid}}",
    "razon_social":"Proveedor Ordenes de Compra",
    "correo":"oc@test.com"
}

> {%
const body = response.parsedBody;
client.global.set("ocProveedorId", body.id);
%}

###

POST {{host}}/api/inventario/productos/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "sku":"OC-{{$guid}}",
    "nombre":"Producto para ordenes de compra",
    "costo_referencia":"10",
    "precio_venta":"20",
    "stock_minimo":"1"
}

> {%
const body = response.parsedBody;
client.global.set("ocProductoId", body.id);
%}

###

POST {{host}}/api/inventario/almacenes/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "nombre":"Almacen Compras {{$guid}}"
}

> {%
const body = response.parsedBody;
client.global.set("ocAlmacenId", body.id);
%}

###########################################################
# CONFIGURACION DE UMBRAL DE APROBACION (RF-52)
###########################################################

GET {{host}}/api/compras/config-aprobacion/
Authorization: Bearer {{token}}

###

PUT {{host}}/api/compras/config-aprobacion/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "umbral_monto":"500"
}

###

# umbral negativo -> debe responder 422 con campo:"umbral_monto"
PUT {{host}}/api/compras/config-aprobacion/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "umbral_monto":"-1"
}

###########################################################
# ORDENES DE COMPRA (RF-47, RF-48)
###########################################################

# Total 100, dentro del umbral (500) -> estado "enviada"
POST {{host}}/api/compras/ordenes/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "proveedor_id":"{{ocProveedorId}}",
    "lineas":[
        {"producto_id":"{{ocProductoId}}", "cantidad":"10", "costo_unitario":"10"}
    ]
}

> {%
const body = response.parsedBody;
client.global.set("ocOrdenId", body.id);
client.global.set("ocLineaId", body.lineas[0].id);
%}

###

# Total 10000, excede el umbral -> estado "pendiente_aprobacion"
POST {{host}}/api/compras/ordenes/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "proveedor_id":"{{ocProveedorId}}",
    "lineas":[
        {"producto_id":"{{ocProductoId}}", "cantidad":"1000", "costo_unitario":"10"}
    ]
}

> {%
const body = response.parsedBody;
client.global.set("ocOrdenPendienteId", body.id);
%}

###

# sin lineas -> debe responder 422 con campo:"lineas"
POST {{host}}/api/compras/ordenes/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "proveedor_id":"{{ocProveedorId}}",
    "lineas":[]
}

###

GET {{host}}/api/compras/ordenes/
Authorization: Bearer {{token}}

###

GET {{host}}/api/compras/ordenes/?estado=pendiente_aprobacion
Authorization: Bearer {{token}}

###

GET {{host}}/api/compras/ordenes/{{ocOrdenId}}/
Authorization: Bearer {{token}}

###

# aprobacion manual (stand-in del motor de aprobaciones, aun no implementado):
# pendiente_aprobacion -> enviada
PATCH {{host}}/api/compras/ordenes/{{ocOrdenPendienteId}}/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "estado":"enviada"
}

###

# transicion de estado no permitida -> debe responder 422 con campo:"estado"
PATCH {{host}}/api/compras/ordenes/{{ocOrdenPendienteId}}/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "estado":"recibida_total"
}

###########################################################
# RECEPCION DE MERCANCIA (RF-49) Y CUENTA POR PAGAR (RF-50)
###########################################################

# Recepcion parcial: 6 de 10 -> orden pasa a "recibida_parcial"
POST {{host}}/api/compras/recepciones/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "orden_id":"{{ocOrdenId}}",
    "almacen_id":"{{ocAlmacenId}}",
    "lineas":[
        {"orden_compra_linea_id":"{{ocLineaId}}", "cantidad":"6", "costo_unitario":"11"}
    ]
}

###

# excede la cantidad pendiente (quedan 4) -> debe responder 422 con campo:"lineas[0].cantidad"
POST {{host}}/api/compras/recepciones/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "orden_id":"{{ocOrdenId}}",
    "almacen_id":"{{ocAlmacenId}}",
    "lineas":[
        {"orden_compra_linea_id":"{{ocLineaId}}", "cantidad":"5", "costo_unitario":"11"}
    ]
}

###

# recibe el remanente (4) -> orden pasa a "recibida_total"
POST {{host}}/api/compras/recepciones/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "orden_id":"{{ocOrdenId}}",
    "almacen_id":"{{ocAlmacenId}}",
    "lineas":[
        {"orden_compra_linea_id":"{{ocLineaId}}", "cantidad":"4", "costo_unitario":"11"}
    ]
}

###

GET {{host}}/api/compras/ordenes/{{ocOrdenId}}/
Authorization: Bearer {{token}}

###

GET {{host}}/api/compras/recepciones/?orden_id={{ocOrdenId}}
Authorization: Bearer {{token}}

###

GET {{host}}/api/compras/cuentas-por-pagar/?proveedor_id={{ocProveedorId}}
Authorization: Bearer {{token}}

###

# el stock disponible del producto debe reflejar las dos recepciones (10 en total)
GET {{host}}/api/inventario/stock-disponible/?producto_id={{ocProductoId}}
Authorization: Bearer {{token}}

###########################################################
# CANCELAR ORDEN DE COMPRA (RF-48)
###########################################################

# orden ya recibida_total -> no puede cancelarse, debe responder 422
POST {{host}}/api/compras/ordenes/{{ocOrdenId}}/cancelar/
Authorization: Bearer {{token}}

###

# orden nueva sin recepciones, se puede cancelar en su totalidad
POST {{host}}/api/compras/ordenes/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "proveedor_id":"{{ocProveedorId}}",
    "lineas":[
        {"producto_id":"{{ocProductoId}}", "cantidad":"5", "costo_unitario":"1"}
    ]
}

> {%
const body = response.parsedBody;
client.global.set("ocOrdenCancelarId", body.id);
%}

###

POST {{host}}/api/compras/ordenes/{{ocOrdenCancelarId}}/cancelar/
Authorization: Bearer {{token}}

###

# orden ya cancelada -> no puede editarse, debe responder 422
PATCH {{host}}/api/compras/ordenes/{{ocOrdenCancelarId}}/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "estado":"enviada"
}

###########################################################
# HISTORIAL DE COMPRAS POR PROVEEDOR (RF-51)
###########################################################

GET {{host}}/api/compras/proveedores/{{ocProveedorId}}/historial/
Authorization: Bearer {{token}}

###

###########################################################
# ROLES Y PERMISOS - RBAC (RF-10 a RF-15)
###########################################################

# catalogo maestro agrupado por dominio, con marca de inertes (RF-11/CA01-CA02)
GET {{host}}/api/core/permisos/
Authorization: Bearer {{token}}

###

# RF-10: alta de rol personalizado
POST {{host}}/api/core/roles/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "nombre":"LECTOR_INVENTARIO",
    "permisos":["inventario:productos:leer", "inventario:stock:leer"]
}

> {%
const body = response.parsedBody;
client.global.set("rolId", body.id);
%}

###

# RF-10/CA03: sin permisos -> 422
POST {{host}}/api/core/roles/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "nombre":"SIN_PERMISOS",
    "permisos":[]
}

###

# RF-10/RN02: permiso fuera del catalogo maestro -> 422
POST {{host}}/api/core/roles/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "nombre":"INVENTADO",
    "permisos":["ventas:loquesea:crear"]
}

###

# RF-10/RN03: nombre duplicado en el tenant -> 422
POST {{host}}/api/core/roles/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "nombre":"LECTOR_INVENTARIO",
    "permisos":["inventario:productos:leer"]
}

###

# RF-11: roles del tenant con permisos, inertes y usuarios asignados
GET {{host}}/api/core/roles/
Authorization: Bearer {{token}}

###

# RF-12: modificar el conjunto de permisos (surte efecto en la siguiente peticion)
PATCH {{host}}/api/core/roles/{{rolId}}/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "permisos":["inventario:productos:leer", "inventario:productos:crear"]
}

###

# RF-12/CA02: el rol de sistema TENANT_ADMIN no puede modificarse -> 403
# (sustituir por el id real de TENANT_ADMIN en core.rol)
PATCH {{host}}/api/core/roles/00000000-0000-0000-0000-000000000000/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "nombre":"OTRO_NOMBRE"
}

###

# RF-14: asignar rol a un usuario
POST {{host}}/api/core/usuarios/{{nuevoUsuarioId}}/roles/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "roles":["{{rolId}}"]
}

###

# RF-15: revocar rol
DELETE {{host}}/api/core/usuarios/{{nuevoUsuarioId}}/roles/{{rolId}}/
Authorization: Bearer {{token}}

###

# RF-13/CA01: con usuarios asignados se bloquea -> 422
DELETE {{host}}/api/core/roles/{{rolId}}/
Authorization: Bearer {{token}}

###

# RF-13: baja logica confirmada
DELETE {{host}}/api/core/roles/{{rolId}}/?desactivar=true
Authorization: Bearer {{token}}

###

# Autorizacion: usuario sin el permiso -> 403 con el codigo requerido
# (tokenNoAdmin lo emite la seccion de RF-05, mas abajo)
POST {{host}}/api/inventario/productos/
Authorization: Bearer {{tokenNoAdmin}}
Content-Type: application/json

{
    "sku":"DENEGADO",
    "nombre":"No autorizado"
}

###

###########################################################
# ALTA Y ACTIVACION DE USUARIOS (RF-05)
###########################################################

# El rol a asignar debe existir en el tenant. /api/core/me/ devuelve los
# nombres de rol del usuario autenticado, pero no sus ids: tomar el id de
# TENANT_ADMIN de core.rol y ponerlo aqui.
@rolId = 00000000-0000-0000-0000-000000000000
@nuevoCorreo = qa.rf05@acme.com
@nuevaPassword = Whatever12345!

# alta -> 201, estado 'pendiente', sin password, notificacion en cola
POST {{host}}/api/core/usuarios/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "correo":"{{nuevoCorreo}}",
    "nombre_completo":"QA RF05",
    "roles":["{{rolId}}"]
}

> {%
const body = response.parsedBody;
client.global.set("activacionToken", body.activacion_token);
client.global.set("nuevoUsuarioId", body.id);
%}

###

# sin roles -> 422 (RN04/CA03)
POST {{host}}/api/core/usuarios/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "correo":"sin.roles@acme.com",
    "nombre_completo":"Sin Roles"
}

###

# correo ya registrado en el tenant -> 422 (RN02)
POST {{host}}/api/core/usuarios/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "correo":"admin@acme.com",
    "nombre_completo":"Duplicado",
    "roles":["{{rolId}}"]
}

###

# rol inexistente en este tenant -> 422 (RN06)
POST {{host}}/api/core/usuarios/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "correo":"rol.malo@acme.com",
    "nombre_completo":"Rol Malo",
    "roles":["11111111-1111-1111-1111-111111111111"]
}

###

# el usuario pendiente no puede autenticarse todavia -> 401 (RN03)
POST {{host}}/api/auth/login/
Content-Type: application/json

{
    "tenant_slug":"{{tenant}}",
    "correo":"{{nuevoCorreo}}",
    "password":"{{nuevaPassword}}"
}

###

# token invalido o vencido -> 422
POST {{host}}/api/auth/activar/
Content-Type: application/json

{
    "token":"basura",
    "password":"{{nuevaPassword}}"
}

###

# password bajo el minimo de config_seguridad_tenant -> 422 (RF-22)
POST {{host}}/api/auth/activar/
Content-Type: application/json

{
    "token":"{{activacionToken}}",
    "password":"corta"
}

###

# activacion -> 200, estado 'activo'
POST {{host}}/api/auth/activar/
Content-Type: application/json

{
    "token":"{{activacionToken}}",
    "password":"{{nuevaPassword}}"
}

###

# token de un solo uso: reintentar -> 422 (CA06)
POST {{host}}/api/auth/activar/
Content-Type: application/json

{
    "token":"{{activacionToken}}",
    "password":"{{nuevaPassword}}"
}

###

# ya activado: ahora si autentica -> 200
POST {{host}}/api/auth/login/
Content-Type: application/json

{
    "tenant_slug":"{{tenant}}",
    "correo":"{{nuevoCorreo}}",
    "password":"{{nuevaPassword}}"
}

> {%
const body = response.parsedBody;
client.global.set("tokenNoAdmin", body.token);
%}

###

# usuario sin rol TENANT_ADMIN dando de alta usuarios -> 403
POST {{host}}/api/core/usuarios/
Authorization: Bearer {{tokenNoAdmin}}
Content-Type: application/json

{
    "correo":"otro@acme.com",
    "nombre_completo":"Otro",
    "roles":["{{rolId}}"]
}

###

