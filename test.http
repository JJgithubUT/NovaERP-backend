###########################################################
# EDITAR USUARIO (RF-07)
###########################################################

# nuevoUsuarioId lo captura el alta de RF-05, mas abajo

# TENANT_ADMIN: modificacion total
PATCH {{host}}/api/core/usuarios/{{nuevoUsuarioId}}/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "nombre_completo":"Nombre Editado",
    "telefono":"5551234567"
}

###

# roles fuera de RF-07 -> 422 (se administran en RF-14/RF-15)
PATCH {{host}}/api/core/usuarios/{{nuevoUsuarioId}}/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "roles":["00000000-0000-0000-0000-000000000000"]
}

###

# estado fuera de RF-07 -> 422 (es RF-08)
PATCH {{host}}/api/core/usuarios/{{nuevoUsuarioId}}/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "estado":"suspendido"
}

###

# RN03: correo ya registrado en el tenant -> 422
PATCH {{host}}/api/core/usuarios/{{nuevoUsuarioId}}/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "correo":"admin@acme.com"
}

###

# RN05/CA04: cambio de correo -> pendiente_verificacion + token de validacion
PATCH {{host}}/api/core/usuarios/{{nuevoUsuarioId}}/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "correo":"correo.nuevo@acme.com"
}

> {%
const body = response.parsedBody;
client.global.set("verificacionToken", body.verificacion_token);
%}

###

# el usuario no puede autenticarse hasta reconfirmar -> 401
POST {{host}}/api/auth/login/
Content-Type: application/json

{
    "tenant_slug":"{{tenant}}",
    "correo":"correo.nuevo@acme.com",
    "password":"{{nuevaPassword}}"
}

###

# ya tiene contrasena: enviarla en la reconfirmacion -> 422
POST {{host}}/api/auth/activar/
Content-Type: application/json

{
    "token":"{{verificacionToken}}",
    "password":"{{nuevaPassword}}"
}

###

# reconfirmacion de correo: mismo endpoint, sin password -> 200 y estado activo
POST {{host}}/api/auth/activar/
Content-Type: application/json

{
    "token":"{{verificacionToken}}"
}

###

# el propietario edita solo sus datos personales (sin core:usuarios:editar)
PATCH {{host}}/api/core/usuarios/{{nuevoUsuarioId}}/
Authorization: Bearer {{tokenNoAdmin}}
Content-Type: application/json

{
    "nombre_completo":"Yo Mismo",
    "telefono":"5559999999"
}

###

# el propietario NO puede cambiar su propio correo -> 422
PATCH {{host}}/api/core/usuarios/{{nuevoUsuarioId}}/
Authorization: Bearer {{tokenNoAdmin}}
Content-Type: application/json

{
    "correo":"otro@acme.com"
}

###

# el propietario NO puede editar a un tercero -> 403
PATCH {{host}}/api/core/usuarios/00000000-0000-0000-0000-000000000000/
Authorization: Bearer {{tokenNoAdmin}}
Content-Type: application/json

{
    "nombre_completo":"Ajeno"
}

###

# RF-07 / RF-16 RN07 — reseteo de MFA (accion exclusiva del TENANT_ADMIN).
# Deja al usuario sin segundo factor; su proximo login (fase 1) devolvera
# mfa:"enroll" con un secreto nuevo para re-enrolar antes de completar acceso.
POST {{host}}/api/core/usuarios/{{nuevoUsuarioId}}/reset-mfa/
Authorization: Bearer {{token}}

###

# el propio usuario NO puede resetearse el MFA -> 403 (no es admin)
POST {{host}}/api/core/usuarios/{{nuevoUsuarioId}}/reset-mfa/
Authorization: Bearer {{tokenNoAdmin}}

###

###########################################################
# SUSPENDER / REACTIVAR USUARIO (RF-08)
###########################################################

# Suspender: cierra todas sus sesiones (RN03) y bloquea su login (RN02).
# No puede suspenderse al ultimo TENANT_ADMIN activo (RN04).
POST {{host}}/api/core/usuarios/{{nuevoUsuarioId}}/suspender/
Authorization: Bearer {{token}}

###

# El usuario suspendido no puede iniciar sesion -> 401 "Su cuenta ha sido
# suspendida. Contacte al administrador." (CA03)
POST {{host}}/api/auth/login/
Content-Type: application/json

{
  "tenant_slug": "{{tenant}}",
  "correo": "{{nuevoCorreo}}",
  "password": "{{nuevaPassword}}"
}

###

# Reactivar: restaura el login y conserva los roles previos (RN05/CA04)
POST {{host}}/api/core/usuarios/{{nuevoUsuarioId}}/reactivar/
Authorization: Bearer {{token}}

###

###########################################################
# SESIONES: LOGOUT Y REVOCACION (RF-17 / RF-19)
###########################################################

# RF-19/CA01: el usuario lista SOLO sus propias sesiones activas (flag "actual")
GET {{host}}/api/core/sesiones/
Authorization: Bearer {{token}}

###

# RF-19/CA03: cerrar todas las demas sesiones, conservar la actual
POST {{host}}/api/core/sesiones/cerrar-otras/
Authorization: Bearer {{token}}

###

# RF-19/CA02: cerrar una sesion propia por su jti (sustituir por uno real de la
# lista anterior). Un jti ajeno no revoca nada (RN01).
DELETE {{host}}/api/core/sesiones/00000000-0000-0000-0000-000000000000/
Authorization: Bearer {{token}}

###

# RF-19/RN02: el TENANT_ADMIN cierra TODAS las sesiones de un usuario (solo
# devuelve el conteo, sin detalle de dispositivos)
POST {{host}}/api/core/usuarios/{{nuevoUsuarioId}}/cerrar-sesiones/
Authorization: Bearer {{token}}

###

# RF-17: logout de la sesion en curso. Tras esto, el mismo token da 401.
POST {{host}}/api/auth/logout/
Authorization: Bearer {{token}}

###

# CA01: el mismo token tras logout -> 401
GET {{host}}/api/core/me/
Authorization: Bearer {{token}}

###

###########################################################
# RECUPERAR / RESTABLECER CONTRASENA (RF-18)
###########################################################

# Solicitud: SIEMPRE responde el mismo mensaje generico (RN02, no revela si el
# correo existe). El token se envia por correo (notificacion encolada), NO en la
# respuesta. Un correo inexistente da exactamente la misma respuesta.
POST {{host}}/api/auth/recuperar/
Content-Type: application/json

{
  "tenant_slug": "{{tenant}}",
  "correo": "{{email}}"
}

###

# Confirmacion: token de un solo uso (1 h). Al restablecer se invalidan TODAS
# las sesiones previas del usuario (RN03). Sustituir por el token real recibido.
POST {{host}}/api/auth/restablecer/
Content-Type: application/json

{
  "token": "TOKEN-RECIBIDO-POR-CORREO",
  "password": "NuevaPassword12345!"
}

###

# /me ahora incluye usuario.ultimo_acceso (RF-09/CA03)
GET {{host}}/api/core/me/
Authorization: Bearer {{token}}

###

###########################################################
# AUDITORIA Y REPORTES (RF-21 / RF-23 / RF-24)
###########################################################

# RF-21: consultar bitacora. Filtros ?usuario_id= ?operacion= ?entidad=
# ?desde=&hasta=. Solo lectura. Exige core:bitacora:leer.
GET {{host}}/api/core/bitacora/?operacion=LOGIN
Authorization: Bearer {{token}}

###

# RF-24: exportar la consulta a CSV (mismos filtros). Se audita como EXPORT.
# Exige core:bitacora:exportar. (PDF pendiente: requiere libreria.)
GET {{host}}/api/core/bitacora/export/?entidad=usuario
Authorization: Bearer {{token}}

###

# RF-23: reporte de actividad por usuario. Filtros ?desde=&hasta=
# ?departamento= ?puesto=. Exige core:reportes:leer.
GET {{host}}/api/core/reportes/actividad/
Authorization: Bearer {{token}}

###

###########################################################
# POLITICAS DE SEGURIDAD DEL TENANT (RF-22)
###########################################################

# Consultar la politica vigente + los limites min/max de plataforma
GET {{host}}/api/core/config-seguridad/
Authorization: Bearer {{token}}

###

# Endurecer la politica (dentro de los limites). No invalida contrasenas ni
# sesiones ya existentes (RN02/CA02); aplica a los siguientes cambios.
PATCH {{host}}/api/core/config-seguridad/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "politica_password_min_len": 16,
    "bloqueo_minutos": 45
}

###

# CA01/RN01: por debajo del minimo de plataforma (8) -> 422 con el limite
PATCH {{host}}/api/core/config-seguridad/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "politica_password_min_len": 6
}

###

###########################################################
# ROLES Y PERMISOS - RBAC (RF-10 a RF-15)
###########################################################

# catalogo maestro agrupado por dominio, con marca de inertes (RF-11/CA01-CA02)
GET {{host}}/api/core/permisos/
Authorization: Bearer {{token}}

###

# RF-10: alta de rol personalizado
POST {{host}}/api/core/roles/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "nombre":"LECTOR_INVENTARIO",
    "permisos":["inventario:productos:leer", "inventario:stock:leer"]
}

> {%
const body = response.parsedBody;
client.global.set("rolId", body.id);
%}

###

# RF-10/CA03: sin permisos -> 422
POST {{host}}/api/core/roles/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "nombre":"SIN_PERMISOS",
    "permisos":[]
}

###

# RF-10/RN02: permiso fuera del catalogo maestro -> 422
POST {{host}}/api/core/roles/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "nombre":"INVENTADO",
    "permisos":["ventas:loquesea:crear"]
}

###

# RF-10/RN03: nombre duplicado en el tenant -> 422
POST {{host}}/api/core/roles/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "nombre":"LECTOR_INVENTARIO",
    "permisos":["inventario:productos:leer"]
}

###

# RF-11: roles del tenant con permisos, inertes y usuarios asignados
GET {{host}}/api/core/roles/
Authorization: Bearer {{token}}

###

# RF-12: modificar el conjunto de permisos (surte efecto en la siguiente peticion)
PATCH {{host}}/api/core/roles/{{rolId}}/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "permisos":["inventario:productos:leer", "inventario:productos:crear"]
}

###

# RF-12/CA02: el rol de sistema TENANT_ADMIN no puede modificarse -> 403
# (sustituir por el id real de TENANT_ADMIN en core.rol)
PATCH {{host}}/api/core/roles/00000000-0000-0000-0000-000000000000/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "nombre":"OTRO_NOMBRE"
}

###

# RF-14: asignar rol a un usuario
POST {{host}}/api/core/usuarios/{{nuevoUsuarioId}}/roles/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "roles":["{{rolId}}"]
}

###

# RF-15: revocar rol
DELETE {{host}}/api/core/usuarios/{{nuevoUsuarioId}}/roles/{{rolId}}/
Authorization: Bearer {{token}}

###

# RF-13/CA01: con usuarios asignados se bloquea -> 422
DELETE {{host}}/api/core/roles/{{rolId}}/
Authorization: Bearer {{token}}

###

# RF-13: baja logica confirmada
DELETE {{host}}/api/core/roles/{{rolId}}/?desactivar=true
Authorization: Bearer {{token}}

###

# Autorizacion: usuario sin el permiso -> 403 con el codigo requerido
# (tokenNoAdmin lo emite la seccion de RF-05, mas abajo)
POST {{host}}/api/inventario/productos/
Authorization: Bearer {{tokenNoAdmin}}
Content-Type: application/json

{
    "sku":"DENEGADO",
    "nombre":"No autorizado"
}

###

###########################################################
# ALTA Y ACTIVACION DE USUARIOS (RF-05)
###########################################################

# El rol a asignar debe existir en el tenant. /api/core/me/ devuelve los
# nombres de rol del usuario autenticado, pero no sus ids: tomar el id de
# TENANT_ADMIN de core.rol y ponerlo aqui.
@rolId = 00000000-0000-0000-0000-000000000000
@nuevoCorreo = qa.rf05@acme.com
@nuevaPassword = Whatever12345!

# RF-06: directorio paginado. Busqueda ?search= (nombre/correo/puesto),
# filtros ?estado= ?departamento= ?rol=<id> ?desde=&hasta=, orden
# ?orden=nombre|created_at|ultimo_acceso (&desc=true). Exige core:usuarios:leer.
GET {{host}}/api/core/usuarios/?orden=nombre
Authorization: Bearer {{token}}

###

GET {{host}}/api/core/usuarios/?search=admin
Authorization: Bearer {{token}}

###

# alta -> 201, estado 'pendiente', sin password, notificacion en cola.
# puesto/departamento son opcionales (los usa el directorio RF-06).
POST {{host}}/api/core/usuarios/
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "correo":"{{nuevoCorreo}}",
    "nombre_completo":"QA RF05",
    "roles":["{{rolId}}"],
    "puesto":"Analista",
    "departamento":"Ventas"
}

